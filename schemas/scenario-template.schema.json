{
  "$defs": {
    "AnswerContract": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "markdown",
          "enum": [
            "markdown",
            "text",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "citations_required": {
          "default": true,
          "title": "Citations Required",
          "type": "boolean"
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        }
      },
      "title": "AnswerContract",
      "type": "object"
    },
    "CriterionSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hard": {
          "default": false,
          "title": "Hard",
          "type": "boolean"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validator"
        }
      },
      "required": [
        "id",
        "dimension",
        "title",
        "description"
      ],
      "title": "CriterionSpec",
      "type": "object"
    },
    "ProviderSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "values": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "ProviderSpec",
      "type": "object"
    },
    "TemplateParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "title": "TemplateParameterSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/TemplateParameterSpec"
      },
      "title": "Parameters",
      "type": "object"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CriterionSpec"
      },
      "title": "Criteria",
      "type": "array"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "title": "Rules",
      "type": "array"
    },
    "answer_contract": {
      "$ref": "#/$defs/AnswerContract"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "difficulty": {
      "default": "mixed",
      "enum": [
        "easy",
        "medium",
        "hard",
        "mixed"
      ],
      "title": "Difficulty",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "prompt",
    "parameters"
  ],
  "title": "ScenarioTemplate",
  "type": "object"
}