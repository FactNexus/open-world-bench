{
  "$defs": {
    "SystemCapabilities": {
      "additionalProperties": false,
      "properties": {
        "browser": {
          "default": false,
          "title": "Browser",
          "type": "boolean"
        },
        "citations": {
          "default": true,
          "title": "Citations",
          "type": "boolean"
        },
        "cost_metrics": {
          "default": false,
          "title": "Cost Metrics",
          "type": "boolean"
        },
        "domain_index": {
          "default": false,
          "title": "Domain Index",
          "type": "boolean"
        },
        "mcp": {
          "default": false,
          "title": "Mcp",
          "type": "boolean"
        },
        "ontology": {
          "default": false,
          "title": "Ontology",
          "type": "boolean"
        },
        "token_metrics": {
          "default": false,
          "title": "Token Metrics",
          "type": "boolean"
        },
        "trace": {
          "default": false,
          "title": "Trace",
          "type": "boolean"
        },
        "web_search": {
          "default": false,
          "title": "Web Search",
          "type": "boolean"
        }
      },
      "title": "SystemCapabilities",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/SystemCapabilities"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "strategy": {
      "anyOf": [
        {
          "enum": [
            "parametric",
            "native_search",
            "private_index",
            "external_tool",
            "web_browse",
            "hybrid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strategy"
    }
  },
  "required": [
    "id",
    "name",
    "adapter"
  ],
  "title": "SystemDefinition",
  "type": "object"
}
