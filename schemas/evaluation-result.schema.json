{
  "$defs": {
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "hard_failure": {
          "default": false,
          "title": "Hard Failure",
          "type": "boolean"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "criterion_id",
        "dimension",
        "score",
        "explanation"
      ],
      "title": "CriterionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "items": {
        "$ref": "#/$defs/CriterionResult"
      },
      "title": "Criteria",
      "type": "array"
    },
    "dimension_scores": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Dimension Scores",
      "type": "object"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluator_version": {
      "title": "Evaluator Version",
      "type": "string"
    },
    "hard_constraint_cap_applied": {
      "default": false,
      "title": "Hard Constraint Cap Applied",
      "type": "boolean"
    },
    "judge_configuration": {
      "additionalProperties": true,
      "title": "Judge Configuration",
      "type": "object"
    },
    "quality_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Quality Score",
      "type": "number"
    },
    "review_status": {
      "default": "not_required",
      "enum": [
        "not_required",
        "required",
        "reviewed"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "evaluated_at",
    "evaluator_version",
    "criteria",
    "dimension_scores",
    "quality_score"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
